rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "rija.bp2rd@gmail.com" && request.auth.token.email_verified == true) ||
        request.auth.token.email == "admin.bp2rd@sipotensi-hsu.go.id" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll(['id', 'requireSaveCode', 'cloudflareEnabled']) &&
        data.keys().hasOnly([
          'id',
          'requireSaveCode',
          'protectPotensi',
          'protectPbb',
          'protectRetribusi',
          'saveCodeHash',
          'saveCodeMasked',
          'saveCodeHint',
          'cloudflareEnabled',
          'cloudflareMode',
          'spreadsheetPasscodeHash',
          'spreadsheetPasscodeMasked',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        data.requireSaveCode is bool &&
        data.cloudflareEnabled is bool &&
        (!('protectPotensi' in data) || data.protectPotensi is bool) &&
        (!('protectPbb' in data) || data.protectPbb is bool) &&
        (!('protectRetribusi' in data) || data.protectRetribusi is bool) &&
        (!('saveCodeHash' in data) || (data.saveCodeHash is string && data.saveCodeHash.size() <= 128)) &&
        (!('saveCodeMasked' in data) || (data.saveCodeMasked is string && data.saveCodeMasked.size() <= 40)) &&
        (!('saveCodeHint' in data) || (data.saveCodeHint is string && data.saveCodeHint.size() <= 280)) &&
        (!('cloudflareMode' in data) || data.cloudflareMode in ['managed', 'strict']) &&
        (!('spreadsheetPasscodeHash' in data) || (data.spreadsheetPasscodeHash is string && data.spreadsheetPasscodeHash.size() <= 128)) &&
        (!('spreadsheetPasscodeMasked' in data) || (data.spreadsheetPasscodeMasked is string && data.spreadsheetPasscodeMasked.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 120));
    }

    // Connection ping test
    match /_connection_test/{id} {
      allow read, write: if isValidId(id);
    }

    // Pengaturan Keamanan & Kode Simpan Data (Hanya Admin yang dapat mengubah; konfigurasi non-rahasia/hash dapat dibaca klien untuk verifikasi)
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidAppSettings(request.resource.data);
      allow delete: if false;
    }

    // Profil Akun Petugas & Admin BP2RD
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // Koleksi Library Berkas & Regulasi
    match /library_berkas/{berkasId} {
      allow get, list: if true;
      allow create, update: if isValidId(berkasId);
      allow delete: if isValidId(berkasId);

      // Subkoleksi potongan file besar (>700KB) agar dokumen utama tidak melebihi batas 1MB Firestore
      match /chunks/{chunkId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(berkasId) && isValidId(chunkId);
      }
    }

    // Koleksi Penggalian Potensi Pajak Daerah
    match /potensi_pajak/{potensiId} {
      allow get, list: if true;
      allow create, update: if isValidId(potensiId);
      allow delete: if isValidId(potensiId);
    }

    // Koleksi Layanan PBB-P2
    match /pbb_p2/{pbbId} {
      allow get, list: if true;
      allow create, update: if isValidId(pbbId);
      allow delete: if isValidId(pbbId);
    }

    // Koleksi Penggalian Potensi Retribusi Daerah
    match /retribusi_daerah/{retribusiId} {
      allow get, list: if true;
      allow create, update: if isValidId(retribusiId);
      allow delete: if isValidId(retribusiId);
    }

    // Koleksi Survei IKM
    match /survei_ikm/{ikmId} {
      allow get, list: if true;
      allow create, update: if isValidId(ikmId);
      allow delete: if isValidId(ikmId);
    }
  }
}
