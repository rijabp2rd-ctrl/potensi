rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profil Akun Petugas & Admin BP2RD
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == "rija.bp2rd@gmail.com";
    }

    // Koleksi Penggalian Potensi Pajak
    match /potensi_pajak/{potensiId} {
      allow read: if true;
      allow create: if isValidId(potensiId) 
        && request.resource.data.id is string
        && request.resource.data.namaObjek is string
        && request.resource.data.namaObjek.size() <= 256
        && request.resource.data.alamat is string
        && request.resource.data.alamat.size() <= 512
        && request.resource.data.noWhatsapp is string
        && request.resource.data.noWhatsapp.size() <= 32;
      allow update, delete: if isSignedIn();
    }

    // Koleksi Layanan PBB-P2
    match /pbb_p2/{pbbId} {
      allow read: if true;
      allow create: if isValidId(pbbId)
        && request.resource.data.id is string
        && request.resource.data.namaWajibPajak is string
        && request.resource.data.namaWajibPajak.size() <= 128
        && request.resource.data.nik is string
        && request.resource.data.nik.size() == 16
        && request.resource.data.lokasiObjek is string
        && request.resource.data.lokasiObjek.size() <= 512;
      allow update, delete: if isSignedIn();
    }

    // Koleksi Survei IKM
    match /survei_ikm/{ikmId} {
      allow read: if true;
      allow create: if isValidId(ikmId)
        && request.resource.data.id is string
        && request.resource.data.namaWajibPajak is string
        && request.resource.data.namaWajibPajak.size() <= 128
        && request.resource.data.alamat is string
        && request.resource.data.alamat.size() <= 512
        && request.resource.data.nilaiKonversi is number;
      allow update, delete: if isSignedIn();
    }
  }
}
